  "compilerOptions": {
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "module": "NodeNext",
    "allowImportingTsExtensions": true,
    "moduleResolution": "NodeNext",
    "target": "ES2022",        // or higher
    "outDir": "./dist",
    "typeRoots": ["./node_modules/@types", "./src/types"]
